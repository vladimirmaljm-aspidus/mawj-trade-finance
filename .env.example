# Supabase (server-side, secret)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (client-side, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Session signing secret (random 64 hex chars — generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-64-hex-chars

# Optional fallback passcode (6 digits) for devices without WebAuthn
DEMO_PASSCODE=000000
